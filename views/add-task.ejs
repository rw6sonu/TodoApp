<!DOCTYPE html>
<html lang="en">

<head>
    <title>Add Task</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <div class="container">

        <div class="row justify-content-center">
            <div class="add-card shadow p-5">

                <h2 class="mb-5 text-white">
                    Add New Task
                </h2>

                <form action="/addTask" method="POST">

                    <div class="mb-3">

                        <label class="form-label">
                            Task Title
                        </label>

                        <input type="text" name="title" class="form-control" placeholder="Enter task title" required>

                    </div>



                    <div class="mb-3">

                        <label class="form-label">
                            Task Description
                        </label>

                        <textarea name="description" class="form-control" rows="4" placeholder="Enter task description"
                            required></textarea>

                    </div>


                    <div class="mb-4">

                        <label class="form-label">
                            Task Priority
                        </label>

                        <select name="priority" class="form-select">

                            <option value="High">
                                High
                            </option>

                            <option value="Medium">
                                Medium
                            </option>

                            <option value="Low">
                                Low
                            </option>

                        </select>

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Task Status
                        </label>

                        <select name="status" class="form-select">

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="In Progress">
                                In Progress
                            </option>

                            <option value="Completed">
                                Completed
                            </option>

                        </select>

                    </div>


                    <button type="submit" class="btn btn-dark w-100">

                        Add Task

                    </button>

                </form>

            </div>

        </div>



    </div>
</body>

</html>